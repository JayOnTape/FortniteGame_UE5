AActor* UBuildingEditTestLibrary::SpawnGrid(UWorld* W){check(W&&W->WorldType==EWorldType::PIE);auto* C=LoadObject<UClass>(nullptr,TEXT("/Game/BuildingSystem/Chapter1Editing/BP_EditGrid.BP_EditGrid_C"));FActorSpawnParameters P;P.SpawnCollisionHandlingOverride=ESpawnActorCollisionHandlingMethod::AlwaysSpawn;return W->SpawnActor<AActor>(C,FVector::ZeroVector,FRotator::ZeroRotator,P);}
void UBuildingEditTestLibrary::StartTest(bool Dedicated){UWorld* W=UEditorLoadingAndSavingUtils::NewBlankMap(false);W->GetWorldSettings()->DefaultGameMode=ABuildingEditTestGameMode::StaticClass();W->GetWorldSettings()->bGlobalGravitySet=true;W->GetWorldSettings()->GlobalGravityZ=0;check(UEditorLoadingAndSavingUtils::SaveMap(W,TEXT("/Game/__CodexTests/BuildingEdit")));
auto* S=NewObject<ULevelEditorPlaySettings>();S->SetPlayNetMode(Dedicated?PIE_Client:PIE_ListenServer);S->SetPlayNumberOfClients(Dedicated?2:3);S->bLaunchSeparateServer=Dedicated;S->SetRunUnderOneProcess(true);FRequestPlaySessionParams P;P.EditorPlaySettings=S;P.StartLocation=FVector(0,0,300);P.StartRotation=FRotator::ZeroRotator;P.bAllowOnlineSubsystem=false;GEditor->RequestPlaySession(P);}
FString UBuildingEditTestLibrary::Read(UObject* O,const FString& Name){return O?BuildSimplify::Export(O,*Name):TEXT("<null>");}
bool UBuildingEditTestLibrary::Write(UObject* O,const FString& Name,const FString& Value){check(O&&O->GetWorld()&&O->GetWorld()->WorldType==EWorldType::PIE);auto* P=FindFProperty<FProperty>(O->GetClass(),*Name);check(P);return P->ImportText_Direct(*Value,P->ContainerPtrToValuePtr<void>(O),O,PPF_None)!=nullptr;}
static bool BuildingTestDispatch(UObject* O,UFunction* Fn,void* D){TGuardValue<bool> Guard(GAllowActorScriptExecutionInEditor,false);int32 Space=O->GetFunctionCallspace(Fn,nullptr);bool Sent=false;if(Space&FunctionCallspace::Remote)Sent=O->CallRemoteFunction(Fn,D,nullptr,nullptr);if(Space&FunctionCallspace::Local){O->ProcessEvent(Fn,D);Sent=true;}return Sent;}
FString UBuildingEditTestLibrary::Invoke(UObject* O,const FString& Name,const FString& Arguments,bool Remote){check(O);auto* Fn=O->FindFunctionChecked(*Name);TArray<uint8> Data;Data.SetNumZeroed(Fn->ParmsSize);for(TFieldIterator<FProperty> P(Fn);P&&(P->PropertyFlags&CPF_Parm);++P)P->InitializeValue_InContainer(Data.GetData());BuildSimplify::J Args;check(FJsonSerializer::Deserialize(TJsonReaderFactory<>::Create(Arguments),Args));for(auto& Pair:Args->Values){auto* P=FindFProperty<FProperty>(Fn,*Pair.Key);checkf(P,TEXT("Unknown argument %s.%s"),*Name,*Pair.Key);check(P->ImportText_Direct(*Pair.Value->AsString(),P->ContainerPtrToValuePtr<void>(Data.GetData()),O,PPF_None));}bool Sent=true;if(Remote)Sent=BuildingTestDispatch(O,Fn,Data.GetData());else{TGuardValue<bool> Guard(GAllowActorScriptExecutionInEditor,true);O->ProcessEvent(Fn,Data.GetData());}BuildSimplify::J Result=MakeShared<FJsonObject>();Result->SetBoolField(TEXT("sent"),Sent);for(TFieldIterator<FProperty> P(Fn);P&&(P->PropertyFlags&CPF_Parm);++P){FString V;P->ExportTextItem_Direct(V,P->ContainerPtrToValuePtr<void>(Data.GetData()),nullptr,O,PPF_None);Result->SetStringField(P->GetName(),V);P->DestroyValue_InContainer(Data.GetData());}FString Out;FJsonSerializer::Serialize(Result.ToSharedRef(),TJsonWriterFactory<>::Create(&Out));return Out;}
AActor* UBuildingEditTestLibrary::SpawnBuilding(UWorld* W,int32 Kind,FVector Location,UClass* Resource,AActor* Owner){check(W&&W->WorldType==EWorldType::PIE&&W->GetNetMode()!=NM_Client);const TCHAR* Kinds[]={TEXT("Wall"),TEXT("Floor"),TEXT("Stairs"),TEXT("Roof")};check(Kind>=0&&Kind<4);auto* C=LoadObject<UClass>(nullptr,*(FString(TEXT("/Game/BuildingSystem/Blueprints/Classes/Building_"))+Kinds[Kind]+TEXT(".Building_")+Kinds[Kind]+TEXT("_C")));auto* A=W->SpawnActor<AActor>(C,Location,FRotator::ZeroRotator);A->SetOwner(Owner);if(Resource){FindFProperty<FClassProperty>(C,TEXT("PlacementResource"))->SetObjectPropertyValue_InContainer(A,Resource);Invoke(A,TEXT("OnBuild"),FString::Printf(TEXT("{\"Resource\":\"%s\"}"),*Resource->GetPathName()),false);}return A;}
bool UBuildingEditTestLibrary::Edit(UActorComponent* Manager,AActor* Building,const TArray<bool>& Tiles,int32 Start,int32 Revision){auto* Fn=Manager->FindFunctionChecked(TEXT("ServerEdit"));TArray<uint8> D;D.SetNumZeroed(Fn->ParmsSize);for(TFieldIterator<FProperty> P(Fn);P&&(P->PropertyFlags&CPF_Parm);++P)P->InitializeValue_InContainer(D.GetData());FindFProperty<FObjectProperty>(Fn,TEXT("Building"))->SetObjectPropertyValue_InContainer(D.GetData(),Building);FindFProperty<FIntProperty>(Fn,TEXT("ExpectedRevision"))->SetPropertyValue_InContainer(D.GetData(),Revision);auto* S=FindFProperty<FStructProperty>(Fn,TEXT("Mask"));if(!S)S=FindFProperty<FStructProperty>(Fn,TEXT("Selection"));check(S);void* Selection=S->ContainerPtrToValuePtr<void>(D.GetData());auto* AP=CastFieldChecked<FArrayProperty>(FStructureEditorUtils::GetPropertyByFriendlyName(CastChecked<UUserDefinedStruct>(S->Struct),TEXT("Tiles")));FScriptArrayHelper Array(AP,AP->ContainerPtrToValuePtr<void>(Selection));Array.Resize(Tiles.Num());for(int I=0;I<Tiles.Num();++I)CastFieldChecked<FBoolProperty>(AP->Inner)->SetPropertyValue(Array.GetRawPtr(I),Tiles[I]);auto* StartProp=CastFieldChecked<FIntProperty>(FStructureEditorUtils::GetPropertyByFriendlyName(CastChecked<UUserDefinedStruct>(S->Struct),TEXT("StairStartCell")));StartProp->SetPropertyValue_InContainer(Selection,Start);bool Sent=BuildingTestDispatch(Manager,Fn,D.GetData());for(TFieldIterator<FProperty> P(Fn);P&&(P->PropertyFlags&CPF_Parm);++P)P->DestroyValue_InContainer(D.GetData());return Sent;}

